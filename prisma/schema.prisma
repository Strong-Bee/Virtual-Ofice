generator client { provider="prisma-client-js" }
datasource db { provider="postgresql" url=env("DATABASE_URL") }
enum WorkspaceRole { OWNER ADMIN DEPARTMENT_SUPERVISOR MEMBER GUEST }
enum PresenceStatus { AVAILABLE AWAY BUSY OFFLINE DND }
enum AIAutonomy { ASSISTANT SUGGEST EXECUTE_WITH_APPROVAL LIMITED_AUTONOMOUS HIGHLY_AUTONOMOUS }
enum AIStatus { WORKING THINKING IN_MEETING PROCESSING WAITING_APPROVAL PAUSED ERROR IDLE }
enum AIRisk { LOW MEDIUM HIGH CRITICAL }
enum AITaskStatus { TODO WORKING REVIEW COMPLETED FAILED }
enum ApprovalStatus { PENDING APPROVED REJECTED EXPIRED }
model User { id String @id @default(uuid()) name String? email String @unique passwordHash String? image String? emailVerified DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt accounts Account[] sessions Session[] memberships WorkspaceMember[] presences Presence[] sentMessages Message[] @relation("MessageSender") supervisors DepartmentSupervisor[] aiSupervised AIEmployee[] avatars Avatar[] }
model Account { userId String type String provider String providerAccountId String refresh_token String? @db.Text access_token String? @db.Text expires_at Int? token_type String? scope String? id_token String? @db.Text session_state String? user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@id([provider,providerAccountId]) }
model Session { sessionToken String @unique userId String expires DateTime user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@id([sessionToken]) }
model Workspace { id String @id @default(uuid()) name String slug String @unique createdAt DateTime @default(now()) updatedAt DateTime @updatedAt members WorkspaceMember[] departments Department[] offices Office[] maps Map[] aiEmployees AIEmployee[] }
model WorkspaceMember { id String @id @default(uuid()) userId String workspaceId String role WorkspaceRole @default(MEMBER) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) @@unique([userId,workspaceId]) @@index([workspaceId,role]) }
model Department { id String @id @default(uuid()) workspaceId String name String slug String description String? workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) members DepartmentMember[] supervisors DepartmentSupervisor[] aiEmployees AIEmployee[] @@unique([workspaceId,slug]) @@index([workspaceId]) }
model DepartmentMember { id String @id @default(uuid()) departmentId String userId String department Department @relation(fields:[departmentId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([departmentId,userId]) }
model DepartmentSupervisor { id String @id @default(uuid()) departmentId String userId String department Department @relation(fields:[departmentId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([departmentId,userId]) }
model Office { id String @id @default(uuid()) workspaceId String name String slug String workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) rooms Room[] maps Map[] @@unique([workspaceId,slug]) }
model Room { id String @id @default(uuid()) officeId String name String slug String office Office @relation(fields:[officeId],references:[id],onDelete:Cascade) @@unique([officeId,slug]) @@index([officeId]) }
model Map { id String @id @default(uuid()) workspaceId String officeId String name String width Int height Int tileSize Int @default(32) data Json workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) office Office @relation(fields:[officeId],references:[id],onDelete:Cascade) objects MapObject[] @@index([workspaceId,officeId]) }
model MapObject { id String @id @default(uuid()) mapId String type String x Float y Float width Float height Float rotation Float @default(0) layer Int @default(0) collision Boolean @default(false) interactive Boolean @default(false) config Json? map Map @relation(fields:[mapId],references:[id],onDelete:Cascade) @@index([mapId,layer]) }
model Avatar { id String @id @default(uuid()) userId String? aiEmployeeId String? @unique name String assetKey String user User? @relation(fields:[userId],references:[id],onDelete:Cascade) aiEmployee AIEmployee? @relation(fields:[aiEmployeeId],references:[id],onDelete:Cascade) @@index([userId]) }
model Presence { id String @id @default(uuid()) userId String workspaceId String roomId String? status PresenceStatus @default(AVAILABLE) x Float @default(0) y Float @default(0) direction String @default("down") lastSeenAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([userId,workspaceId]) @@index([workspaceId,roomId,status]) }
model Message { id String @id @default(uuid()) workspaceId String roomId String? senderId String content String @db.Text createdAt DateTime @default(now()) sender User @relation("MessageSender",fields:[senderId],references:[id],onDelete:Cascade) @@index([workspaceId,roomId,createdAt]) }
model AIEmployee { id String @id @default(uuid()) workspaceId String departmentId String supervisorId String? name String role String avatarKey String? systemPrompt String @db.Text modelProvider String modelName String temperature Float @default(0.2) maxTokens Int @default(4096) status AIStatus @default(IDLE) autonomyLevel AIAutonomy @default(EXECUTE_WITH_APPROVAL) dailyBudget Decimal @default(0) monthlyBudget Decimal @default(0) workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) department Department @relation(fields:[departmentId],references:[id],onDelete:Cascade) supervisor User? @relation(fields:[supervisorId],references:[id],onDelete:SetNull) avatar Avatar? tasks AIEmployeeTask[] activities AIEmployeeActivity[] approvals AIApproval[] @@index([workspaceId,departmentId,status]) }
model AIEmployeeTask { id String @id @default(uuid()) aiEmployeeId String title String description String? @db.Text status AITaskStatus @default(TODO) risk AIRisk @default(LOW) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt aiEmployee AIEmployee @relation(fields:[aiEmployeeId],references:[id],onDelete:Cascade) approvals AIApproval[] @@index([aiEmployeeId,status,createdAt]) }
model AIEmployeeActivity { id String @id @default(uuid()) aiEmployeeId String eventType String summary String tokens Int? estimatedCost Decimal? createdAt DateTime @default(now()) aiEmployee AIEmployee @relation(fields:[aiEmployeeId],references:[id],onDelete:Cascade) @@index([aiEmployeeId,createdAt]) }
model AIApproval { id String @id @default(uuid()) aiEmployeeId String taskId String? action String risk AIRisk status ApprovalStatus @default(PENDING) reason String? createdAt DateTime @default(now()) resolvedAt DateTime? aiEmployee AIEmployee @relation(fields:[aiEmployeeId],references:[id],onDelete:Cascade) task AIEmployeeTask? @relation(fields:[taskId],references:[id],onDelete:Cascade) @@index([aiEmployeeId,status,createdAt]) }